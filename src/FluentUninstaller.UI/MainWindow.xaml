<ui:FluentWindow x:Class="FluentUninstaller.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:models="clr-namespace:FluentUninstaller.Core.Models;assembly=FluentUninstaller.Core"
        xmlns:viewModels="clr-namespace:FluentUninstaller.UI.ViewModels"
        mc:Ignorable="d"
        Title="Fluent Uninstaller" Height="780" Width="1220"
        MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        AllowDrop="True"
        PreviewDragOver="Window_DragOver"
        PreviewDragLeave="Window_DragLeave"
        PreviewDrop="Window_Drop"
        PreviewQueryContinueDrag="Window_QueryContinueDrag">

    <Window.Resources>
        <ContextMenu x:Key="SettingsContextMenu">
            <MenuItem Header="Auto-Clean Leftovers Mode:" IsEnabled="False" FontWeight="Bold" />
            <MenuItem x:Name="MenuAutoCleanAsk" Header="Ask before cleaning (Toast)" 
                      IsCheckable="True" Click="MenuAutoClean_Click" Tag="Ask" />
            <MenuItem x:Name="MenuAutoCleanAlways" Header="Always clean automatically" 
                      IsCheckable="True" Click="MenuAutoClean_Click" Tag="AlwaysClean" />
            <MenuItem x:Name="MenuAutoCleanNever" Header="Never clean automatically" 
                      IsCheckable="True" Click="MenuAutoClean_Click" Tag="NeverClean" />
            <Separator />
            <MenuItem Header="Start with Windows (Background Watchdog)" Tag="AutoStart" 
                      IsCheckable="True" Click="MenuStartWithWindows_Click" />
        </ContextMenu>
    </Window.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0: TitleBar -->
            <RowDefinition Height="Auto" /> <!-- 1: Toolbar -->
            <RowDefinition Height="*" />    <!-- 2: Central Work Area -->
            <RowDefinition Height="Auto" /> <!-- 3: Status Bar -->
        </Grid.RowDefinitions>

        <!-- Drag & Drop Overlay Layer -->
        <Grid x:Name="DragDropOverlay" Grid.RowSpan="4" Background="#AA000000" Visibility="Collapsed" Panel.ZIndex="1000" IsHitTestVisible="False">
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2" 
                    CornerRadius="16" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="56" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,15" />
                    <TextBlock Text="Drop shortcut (.lnk) or .exe here" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Fluent Uninstaller will resolve the target, start uninstallation, and clean all leftovers" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>



        <!-- 0. Native TitleBar (Window Controls: Minimize, Maximize, Close) -->
        <ui:TitleBar Grid.Row="0" x:Name="TitleBar" Title="Fluent Uninstaller">

            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Theme Toggle Button -->
                    <ui:Button x:Name="BtnThemeToggle" 
                               Appearance="Secondary" 
                               Icon="{ui:SymbolIcon WeatherMoon24}" 
                               ToolTip="Toggle Theme (Light / Dark)" 
                               Click="BtnThemeToggle_Click" 
                               Padding="8,4" Margin="10,0,8,0" />

                    <!-- Settings Button with AutoClean Options Menu -->
                    <ui:Button x:Name="BtnSettings" 
                               Appearance="Secondary" 
                               Icon="{ui:SymbolIcon Settings24}" 
                               ToolTip="Auto-clean settings" 
                               ContextMenu="{StaticResource SettingsContextMenu}"
                               Click="BtnSettings_Click" 
                               Padding="8,4" Margin="0,0,10,0" />

                    <!-- Watchdog status badge -->
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonUp="BtnSettings_Click" ToolTip="Click to configure auto-clean mode">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="#107C41" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="WatchdogBadgeText" Text="Auto-Watchdog: Ask" FontSize="11" FontWeight="Medium" 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 1. Header Toolbar -->
        <Border Grid.Row="1" Padding="20,10,20,12" 
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <ui:TextBox Grid.Column="0" 
                            x:Name="SearchBox" 
                            PlaceholderText="Search by name or drop a shortcut..." 
                            Icon="{ui:SymbolIcon Search24}"
                            TextChanged="SearchBox_TextChanged" />

                <!-- Filter Chips -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <RadioButton x:Name="FilterAllRadio" Content="All Apps" IsChecked="True" Margin="0,0,15,0" />
                    <RadioButton x:Name="FilterLargeRadio" Content="Large (>500 MB)" Margin="0,0,15,0" />
                    <RadioButton x:Name="FilterMsiRadio" Content="MSI Packages" Margin="0,0,15,0" />
                </StackPanel>

                <!-- Refresh Button -->
                <ui:Button Grid.Column="2" x:Name="BtnRefresh" Content="Refresh List" 
                           Icon="{ui:SymbolIcon ArrowClockwise24}" 
                           Click="BtnRefresh_Click" />
            </Grid>
        </Border>

        <!-- 2. Central Area: Split between App List and Detailed Inspector -->
        <Grid Grid.Row="2" Margin="20,12,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" x:Name="AppListCol" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="440" x:Name="LeftoverCol" />
            </Grid.ColumnDefinitions>

            <!-- Standard High-Performance Stable DataGrid with Fluent Dark Theme Support -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="5">
                <DataGrid x:Name="AppsDataGrid" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False" 
                          IsReadOnly="True" 
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="AppsDataGrid_SelectionChanged"
                          MouseDoubleClick="AppsDataGrid_MouseDoubleClick"
                          HeadersVisibility="Column"
                          RowHeight="54"
                          GridLinesVisibility="None"
                          HorizontalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.PanningMode="Both"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingPanel.CacheLength="20,20"
                          VirtualizingPanel.CacheLengthUnit="Item">

                    <DataGrid.Resources>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridRow}">
                                        <Border x:Name="DgrBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                Padding="4,2"
                                                CornerRadius="8"
                                                Margin="4,2,4,2"
                                                SnapsToDevicePixels="True">
                                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DgrBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                <Setter TargetName="DgrBorder" Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="DgrBorder" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                                <Setter TargetName="DgrBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </DataGrid.Resources>

                    <!-- Context Menu for Rows -->
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Uninstall Program" Click="MenuUninstall_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Delete24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Scan Leftover Files &amp; Registry" Click="MenuScanLeftovers_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Broom24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Open Install Folder" Click="MenuOpenFolder_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="FolderOpen24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Copy Install Path" Click="MenuCopyPath_Click">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Copy24" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!-- App Icon + Name + Publisher Subtext -->
                        <DataGridTemplateColumn Header="Application" Width="3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type viewModels:AppItemViewModel}">
                                    <Grid Margin="6,0,6,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" 
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}" Width="24" Height="24" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" 
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Publisher, TargetNullValue='Unknown publisher'}" 
                                                       FontSize="11" TextTrimming="CharacterEllipsis" 
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Version -->
                        <DataGridTextColumn Header="Version" Binding="{Binding DisplayVersion, TargetNullValue='—'}" Width="110" />

                        <!-- Size Badge -->
                        <DataGridTemplateColumn Header="Size" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type viewModels:AppItemViewModel}">
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" 
                                            CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SizeFormatted}" FontSize="11" FontWeight="Medium" 
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Type Pill Badge -->
                        <DataGridTemplateColumn Header="Type" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type viewModels:AppItemViewModel}">
                                    <Border Background="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                            CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Type}" FontSize="10" FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Quick Action Hover Buttons -->
                        <DataGridTemplateColumn Header="Actions" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type viewModels:AppItemViewModel}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <!-- Quick Uninstall Button -->
                                        <ui:Button Appearance="Danger" Padding="6,4" Margin="0,0,4,0"
                                                   Icon="{ui:SymbolIcon Delete20}" ToolTip="Uninstall program"
                                                   Tag="{Binding}" Click="QuickRowUninstall_Click" />
                                        <!-- Quick Scan Leftovers Button -->
                                        <ui:Button Appearance="Secondary" Padding="6,4" Margin="0,0,4,0"
                                                   Icon="{ui:SymbolIcon Broom20}" ToolTip="Scan leftovers (files &amp; registry)"
                                                   Tag="{Binding}" Click="QuickRowScan_Click" />
                                        <!-- Open Folder Button -->
                                        <ui:Button Appearance="Transparent" Padding="6,4"
                                                   Icon="{ui:SymbolIcon FolderOpen20}" ToolTip="Open install folder"
                                                   Tag="{Binding}" Click="QuickRowOpenFolder_Click" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch" 
                          Background="Transparent" Cursor="SizeWE" />

            <!-- Detailed App Card & Leftovers Inspector -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <!-- State A: Placeholder when no app selected -->
                    <StackPanel x:Name="NoSelectionPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="CursorClick24" FontSize="48" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,15" />
                        <TextBlock Text="Select an Application" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Click any row on the left or drop a shortcut here for fast removal" 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   FontSize="12" TextWrapping="Wrap" TextAlignment="Center" 
                                   MaxWidth="280" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- State B: Active App Inspector -->
                    <Grid x:Name="AppDetailsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header with App Icon and Titles -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="8" 
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                    Margin="0,0,15,0">
                                <Image x:Name="SelectedAppIcon" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="DetailAppName" Text="Application Name" 
                                           FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailAppPublisher" Text="Application Publisher" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                           FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <!-- Meta Info Grid -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                CornerRadius="6" Padding="12" Margin="0,0,0,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Version:" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Margin="0,2,0,2" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailVersion" Text="-" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" Margin="0,2,0,2" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Size:" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Margin="0,2,0,2" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailSize" Text="-" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="12" Margin="0,2,0,2" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Path:" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Margin="0,2,0,2" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailPath" Text="-" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,2" />
                            </Grid>
                        </Border>

                        <!-- Primary Action Buttons -->
                        <Grid Grid.Row="2" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:Button Grid.Column="0" x:Name="BtnDetailUninstall" 
                                       Content="Uninstall App" 
                                       Appearance="Danger" 
                                       Icon="{ui:SymbolIcon Delete24}" 
                                       HorizontalAlignment="Stretch" 
                                       Click="BtnUninstall_Click" />

                            <ui:Button Grid.Column="2" x:Name="BtnDetailScanLeftovers" 
                                       Content="Scan Leftovers" 
                                       Appearance="Primary" 
                                       Icon="{ui:SymbolIcon Broom24}" 
                                       HorizontalAlignment="Stretch" 
                                       Click="BtnScanLeftovers_Click" />
                        </Grid>

                        <!-- Leftovers Section Header & List -->
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Leftover Files &amp; Registry" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="LeftoverCountBadge" Text=" (0)" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="13" />
                            </StackPanel>

                            <!-- Placeholder when scan not performed yet -->
                            <Border Grid.Row="1" x:Name="LeftoversScanPlaceholder" 
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                                    CornerRadius="6" Padding="15">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Shield24" FontSize="32" 
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,8" />
                                    <TextBlock Text="Click «Scan Leftovers»" FontWeight="Medium" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Finds orphaned files in AppData, ProgramData, and deep registry keys" 
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" 
                                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Actual List of Leftovers -->
                            <ListView Grid.Row="1" x:Name="LeftoverListView" BorderThickness="0" Background="Transparent" Visibility="Collapsed"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel">
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:LeftoverItem}">
                                        <Border Padding="8" Margin="0,2,0,2" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Path}" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding TypeDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding SizeFormatted}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Reason}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- Clean Selected Leftovers Button -->
                        <ui:Button Grid.Row="4" x:Name="BtnCleanLeftovers" 
                                   Content="Clean Selected Leftovers" 
                                   Appearance="Caution" 
                                   Icon="{ui:SymbolIcon Broom24}" 
                                   HorizontalAlignment="Stretch" 
                                   Margin="0,12,0,0" 
                                   Visibility="Collapsed" 
                                   Click="BtnCleanLeftovers_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Status Bar -->
        <Border Grid.Row="3" Padding="20,8,20,8" 
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Loading installed applications..." 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
                <TextBlock Grid.Column="1" Text="FluentUninstaller Open-Source" 
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
