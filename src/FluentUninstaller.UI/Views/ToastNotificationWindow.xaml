<Window x:Class="FluentUninstaller.UI.Views.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Fluent Uninstaller Notification" 
        Height="185" Width="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <Storyboard x:Key="ShowAnim">
            <DoubleAnimation Storyboard.TargetName="RootBorder" 
                             Storyboard.TargetProperty="Opacity" 
                             From="0" To="1" Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetName="RootTransform" 
                             Storyboard.TargetProperty="Y" 
                             From="35" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- 100% Solid Card (Opaque) with crisp Fluent border & drop shadow -->
    <Border x:Name="RootBorder" Margin="10" 
            Padding="18,14,18,14"
            Background="#202020"
            BorderBrush="#454545" 
            BorderThickness="1" 
            CornerRadius="12">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTransform" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.75" Direction="270" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header with Close Button -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Broom24" FontSize="16" 
                                   Foreground="#4CC2FF" Margin="0,0,8,0" />
                    <TextBlock x:Name="HeaderBadgeText" Text="Fluent Uninstaller • Uninstall Detected" FontSize="11" FontWeight="SemiBold" 
                               Foreground="#AAAAAA" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="1" 
                        Background="Transparent" BorderThickness="0" 
                        Padding="6,2" Cursor="Hand"
                        Click="BtnClose_Click" ToolTip="Close">
                    <ui:SymbolIcon Symbol="Dismiss16" Foreground="#888888" FontSize="14" />
                </Button>
            </Grid>

            <!-- 2. Body with App Icon & Info -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" 
                        Background="#2B2B2B" 
                        BorderBrush="#484848" BorderThickness="1"
                        Margin="0,0,12,0" VerticalAlignment="Center">
                    <Image x:Name="AppIconImage" Width="30" Height="30" 
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="AppTitleText" Text="Application Uninstalled" 
                               FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LeftoverDetailsText" 
                               Text="Residual items detected..." 
                               Foreground="#D0D0D0" 
                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- 3. High-Contrast Action Buttons -->
            <Grid Grid.Row="2" x:Name="ActionButtonsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Primary Clean Button -->
                <Button Grid.Column="0" x:Name="BtnCleanNow" 
                        Background="#0078D4" Foreground="#FFFFFF"
                        BorderBrush="#1084D9" BorderThickness="1"
                        FontWeight="SemiBold" FontSize="12"
                        Height="32" Cursor="Hand"
                        Click="BtnCleanNow_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Broom24" FontSize="15" Margin="0,0,6,0" Foreground="#FFFFFF" />
                        <TextBlock x:Name="BtnCleanText" Text="Clean Leftovers" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Secondary Inspect/Open Button -->
                <Button Grid.Column="2" x:Name="BtnOpenApp" 
                        Background="#323232" Foreground="#E0E0E0"
                        BorderBrush="#555555" BorderThickness="1"
                        FontWeight="Normal" FontSize="12"
                        Padding="14,0" Height="32" Cursor="Hand"
                        Click="BtnOpenApp_Click">
                    <TextBlock Text="Show in App" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
