<ui:FluentWindow x:Class="FluentUninstaller.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Fluent Uninstaller Setup" 
        Height="490" Width="590"
        MinHeight="490" MinWidth="590"
        MaxHeight="490" MaxWidth="590"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        ResizeMode="NoResize">

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- TitleBar -->
            <RowDefinition Height="*" />    <!-- Content Area -->
            <RowDefinition Height="Auto" /> <!-- Action Footer -->
        </Grid.RowDefinitions>

        <!-- 0. Native TitleBar without window controls (Minimize, Maximize, Close hidden) -->
        <ui:TitleBar Grid.Row="0" x:Name="TitleBar" Title="Fluent Uninstaller Setup"
                     ShowMinimize="False" ShowMaximize="False" ShowClose="False" CanMaximize="False" />

        <!-- 1. Central Content -->
        <Grid Grid.Row="1" Margin="32,8,32,16">
            <StackPanel VerticalAlignment="Top">
                <!-- Header Hero -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14" 
                            Background="{DynamicResource AccentFillColorDefaultBrush}" 
                            Margin="0,0,16,0">
                        <ui:SymbolIcon Symbol="Apps28" FontSize="26" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HeroTitleText" Text="Install Fluent Uninstaller" 
                                   FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="HeroSubtitleText" Text="Fast, modern, open-source software uninstaller for Windows" 
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Install Mode View (Card) -->
                <Border x:Name="InstallPanel" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="18">
                    <StackPanel>
                        <!-- Folder Section -->
                        <TextBlock Text="Installation Folder" FontWeight="SemiBold" FontSize="13" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8" />
                        
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <ui:TextBox Grid.Column="0" x:Name="InstallPathBox" IsReadOnly="True" Height="34" VerticalContentAlignment="Center" />
                            <ui:Button Grid.Column="2" Content="Browse..." Click="BtnBrowse_Click" Appearance="Secondary" Height="34" Padding="14,0" />
                        </Grid>

                        <Separator Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,12" />

                        <!-- Options Section -->
                        <TextBlock Text="Preferences" FontWeight="SemiBold" FontSize="13" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8" />
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Row="0" Grid.Column="0" x:Name="ChkDesktopShortcut" Content="Desktop shortcut" IsChecked="True" Margin="0,0,0,8" />
                            <CheckBox Grid.Row="0" Grid.Column="1" x:Name="ChkStartMenuShortcut" Content="Start menu shortcut" IsChecked="True" Margin="0,0,0,8" />
                            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ChkAutoStart" Content="Start with Windows (Background Watchdog)" IsChecked="True" Margin="0,0,0,8" />
                            <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="ChkLaunchApp" Content="Launch Fluent Uninstaller when finished" IsChecked="True" Margin="0,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Uninstall Mode View (Card) -->
                <Border x:Name="UninstallPanel" Visibility="Collapsed"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Are you sure you want to uninstall Fluent Uninstaller?" 
                                   FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="This will remove the program files, desktop and start menu shortcuts, and uninstall registry entries." 
                                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" LineHeight="18" />
                    </StackPanel>
                </Border>

                <!-- Progress / Status Card (shown during and after installation) -->
                <Border x:Name="ProgressBorder" Visibility="Collapsed"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,6,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                            <ui:ProgressRing x:Name="ProgressSpinner" IsIndeterminate="True" Width="22" Height="22" Margin="0,0,12,0" />
                            <ui:SymbolIcon x:Name="SuccessIcon" Symbol="CheckmarkCircle24" FontSize="24" Foreground="#4CC2FF" Margin="0,0,12,0" Visibility="Collapsed" />
                            <TextBlock x:Name="StatusText" Text="Ready" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ProgressBar x:Name="ProgressBar" Height="4" Value="0" Maximum="100" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. Action Footer -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="32,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="VersionText" Text="Version 1.0.0 (x64)" 
                           VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <ui:Button Grid.Column="1" x:Name="BtnCancel" Content="Cancel" IsCancel="True"
                           Appearance="Secondary" Padding="20,6" Click="BtnCancel_Click" />

                <ui:Button Grid.Column="3" x:Name="BtnAction" Content="Install" IsDefault="True"
                           Appearance="Primary" Padding="24,6" Click="BtnAction_Click" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
